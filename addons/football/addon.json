        ],
        [
          "esp.1",
          "La Liga"
        ],
        [
          "ger.1",
          "Bundesliga"
        ],
        [
          "ita.1",
          "Serie A"
        ],
        [
          "fra.1",
          "Ligue 1"
        ],
        [
          "uefa.champions",
          "Champions League"
        ],
        [
          "ksa.1",
          "Saudi Pro League"
        ]
      ]
    },
    {
      "key": "team",
      "label": "Only this team (optional)",
