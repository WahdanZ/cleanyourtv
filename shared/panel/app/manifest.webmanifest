{
  "name": "Home Admin",
  "short_name": "Home",
  "description": "Your TV and Chromecast home screens: layout, widgets, wallpaper, VPN and a remote.",
  "id": "/admin",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
