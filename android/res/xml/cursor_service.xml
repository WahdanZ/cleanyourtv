<?xml version="1.0" encoding="utf-8"?>
<!-- The trackpad's pointer (CursorService): it only draws the pointer and taps or scrolls where it points. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/cursor_desc"
    android:accessibilityEventTypes="typeWindowStateChanged|typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="1000"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false" />
